    {
      "id": "warren-buffett",
      "name": "Warren Buffett",
      "name_zh": "沃伦·巴菲特",
      "school": "quality-value",
      "scope": ["company", "security", "portfolio"],
      "summary": "把股票视为企业所有权，在能力圈内寻找具备持久竞争优势、可信管理层和长期再投资能力的企业，并以相对内在价值有吸引力的价格买入。",
      "principles": [
        "先理解企业如何赚钱，再讨论证券价格。",
        "把护城河、管理层诚信和资本配置作为长期价值的核心。",
        "内在价值是区间而非精确点估计，并需要安全余量。",
        "机会稀缺时保持耐心，真正高把握时允许集中。"
      ],
      "questions": [
        "如果市场关闭十年，仍愿意持有这门生意吗？",
        "新增留存收益能否以较高回报率继续投入？",
        "什么变化会永久削弱护城河或管理层可信度？"
      ],
      "focus_tags": [
        "business_quality",
        "capital_allocation",
        "circle_of_competence",
        "downside",
        "management",
        "margin_of_safety",
        "moat",
